---
// Homepage: who Anando is on the left, a day in his life in 3D on the right.
// The character sets <html data-scene> and repaints the palette as his clock runs.
import Character3D from "../components/Character3D.astro";

const links = [
  { label: "Substack", href: "https://substack.com/@anandoghose", aria: "Follow me on Substack" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/anandoghose/", aria: "Connect with me on LinkedIn" },
  { label: "GitHub", href: "https://github.com/anandogs", aria: "See my code on GitHub" },
  { label: "Instagram", href: "https://www.instagram.com/anandoghose/", aria: "Follow me on Instagram" },
  { label: "YouTube", href: "https://www.youtube.com/@anandogs", aria: "Subscribe to my YouTube channel" },
];
---

<!doctype html>
<html lang="en" data-scene="work">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anando Ghose - Automation, Tech, Finance</title>
    <meta name="title" content="Anando Ghose | Automation, Tech, Finance" />
    <meta
      name="description"
      content="Finance automation specialist with expertise in reporting & analytics. Self-taught programmer, with MBA from Indian School of Business."
    />
    <meta name="author" content="Anando Ghose" />
    <meta
      name="keywords"
      content="Anando Ghose, finance automation, analytics, web development, self-taught programmer, CS50, MBA, Indian School of Business"
    />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://anandoghose.com/" />
    <meta
      property="og:title"
      content="Anando Ghose | Automation, Tech, Finance"
    />
    <meta
      property="og:description"
      content="Finance automation specialist with expertise in reporting & analytics. Self-taught programmer, with MBA from Indian School of Business."
    />
    <meta
      property="og:image"
      content="https://anandoghose.com/profile-image.jpg"
    />
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content="https://anandoghose.com/" />
    <meta
      property="twitter:title"
      content="Anando Ghose | Automation, Tech, Finance"
    />
    <meta
      property="twitter:description"
      content="Finance automation specialist with expertise in reporting & analytics. Self-taught programmer, with MBA from Indian School of Business."
    />
    <meta
      property="twitter:image"
      content="https://anandoghose.com/profile-image.jpg"
    />
    <link rel="canonical" href="https://anandoghose.com" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Anando Ghose",
        "url": "https://anandoghose.com",
        "email": "me@anandoghose.com",
        "jobTitle": "Finance Automation Specialist",
        "description": "Finance automation specialist with expertise in reporting & analytics. Self-taught programmer who learned programming through Harvard's CS50  online course. MBA graduate from the Indian School of Business.",
        "alumniOf": [
          {
            "@type": "CollegeOrUniversity",
            "name": "Indian School of Business",
            "sameAs": "https://www.isb.edu/"
          },
          {
            "@type": "EducationalOrganization",
            "name": "Harvard University CS50",
            "sameAs": "https://cs50.harvard.edu/"
          }
        ],
        "knowsAbout": [
          "Finance Automation",
          "Analytics",
          "Machine Learning",
          "Data Science",
          "Web Development",
          "Programming"
        ],
        "sameAs": [
          "https://www.linkedin.com/in/anandoghose/",
          "https://github.com/anandogs",
          "https://www.instagram.com/anandoghose/",
          "https://www.youtube.com/channel/UCb8LzmczkHjCz0Bhvgg-QjA",
          "https://substack.com/@anandoghose"
        ]
      }
    </script>
  </head>
  <body>
    <div class="page">
      <main class="intro">
        <p class="eyebrow">Anando Ghose</p>
        <h1>
          Hi, I'm Anando,
          <span class="nickname" id="nickname">an automation sage</span>
        </h1>
        <p class="about">
          I build automations for reporting &amp; analytics, and like turning
          complex problems into elegant solutions. Self-taught programmer. MBA
          from the Indian School of Business.
        </p>

        <a href="mailto:me@anandoghose.com" class="email" id="copy-email">Email me</a>

        <ul class="links">
          {
            links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.aria}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>
      </main>

      <div class="stage">
        <Character3D />
      </div>
    </div>

    <style is:global>
      /* The morning palette. Once the character is running it rewrites these on
         <html> many times a second to follow the clock through his day. */
      :root {
        --paper: #f1e7d6;
        --paper-deep: #ecdfc8;
        --glow: #fbf4e6;
        --sun-core: #fff9ea;
        --ink: #2b1c12;
        --ink-soft: #6a5443;
        --accent: #b23026;
        --sun-x: 58%;
        --sun-y: 26%;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Inter", system-ui, sans-serif;
        color: var(--ink);
        background: var(--paper);
        min-height: 100dvh;
      }
    </style>

    <style>
      .page {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
        min-height: 100dvh;
        background: linear-gradient(180deg, var(--paper) 0%, var(--paper-deep) 100%);
        overflow: hidden;
      }

      .intro {
        align-self: center;
        padding: clamp(1.5rem, 5vw, 4.5rem);
        padding-right: 0;
        z-index: 1;
      }

      .eyebrow {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 1.25rem;
      }

      h1 {
        font-size: clamp(2.4rem, 5.2vw, 4.25rem);
        font-weight: 800;
        line-height: 1.02;
        letter-spacing: -0.03em;
      }

      .nickname {
        display: block;
        min-height: 1.3em;
        margin-top: 0.15em;
        font-family: "Caveat", cursive;
        font-weight: 500;
        font-size: 0.8em;
        letter-spacing: 0;
        color: var(--accent);
        transition:
          opacity 0.18s ease,
          transform 0.18s ease;
      }

      .nickname.is-swapping {
        opacity: 0;
        transform: translateY(0.2em) rotate(-1deg);
      }

      .about {
        max-width: 29rem;
        margin-top: 1.5rem;
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--ink-soft);
      }

      .email {
        display: inline-block;
        margin-top: 1.75rem;
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 3px;
        text-underline-offset: 0.22em;
      }

      .email:hover {
        color: var(--accent);
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        margin-top: 1.5rem;
        list-style: none;
      }

      .links a {
        color: var(--ink);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, var(--ink) 30%, transparent);
        text-underline-offset: 0.25em;
      }

      .links a:hover {
        color: var(--accent);
        text-decoration-color: currentColor;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
      }

      .stage {
        position: relative;
        height: 100dvh;
        min-height: 26rem;
      }

      /* The sun: a disc in its own glow, crossing the sky and sinking as his day goes on. */
      .stage::before {
        content: "";
        position: absolute;
        /* spills behind the text so the glow never ends on the stage's edge */
        inset: -35% 0 0 -35%;
        --x: calc(26% + var(--sun-x) * 0.74);
        --y: calc(26% + var(--sun-y) * 0.74);
        background:
          radial-gradient(circle at var(--x) var(--y), var(--sun-core) 0 2.1rem, transparent 2.25rem),
          radial-gradient(45% 40% at var(--x) var(--y), var(--glow) 0%, transparent 70%);
        pointer-events: none;
      }

      /* No WebGL, or the model never arrived: the page is simply the words. */
      :global(:root[data-character="failed"]) .stage {
        display: none;
      }
      :global(:root[data-character="failed"]) .page {
        grid-template-columns: minmax(0, 40rem);
        justify-content: center;
      }
      :global(:root[data-character="failed"]) .intro {
        padding-right: clamp(1.5rem, 5vw, 4.5rem);
      }

      @media (max-width: 820px) {
        .page {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: auto 1fr;
        }

        .intro {
          padding: 1.75rem 1.25rem 0;
        }

        .eyebrow {
          margin-bottom: 0.75rem;
        }

        .about {
          margin-top: 1rem;
          font-size: 1rem;
        }

        .email {
          margin-top: 1.1rem;
          font-size: 1.25rem;
        }

        .links {
          margin-top: 1rem;
        }

        .stage {
          height: auto;
          min-height: max(24rem, 52dvh);
        }

        :global(:root[data-character="failed"]) .intro {
          align-self: start;
          padding-bottom: 2rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .nickname {
          transition: none;
        }
      }
    </style>

    <script>
      import { nicknames } from "../data/nicknames";
      import type { SceneId } from "../data/scenes";

      const nicknameEl = document.getElementById("nickname")!;
      let scene = (document.documentElement.dataset.scene ?? "work") as SceneId;
      let current = "";

      // Arriving in a scene deals one of its own nicknames; a tap can deal anything that fits.
      function dealNickname(onlyThisScene: boolean) {
        const own = nicknames.filter((n) => n.scene === scene);
        const pool = onlyThisScene && own.length ? own : nicknames.filter((n) => !n.scene || n.scene === scene);
        const fresh = pool.filter((n) => n.text !== current);
        const next = (fresh.length ? fresh : pool)[Math.floor(Math.random() * (fresh.length || pool.length))].text;
        current = next;
        nicknameEl.classList.add("is-swapping");
        setTimeout(() => {
          nicknameEl.textContent = next;
          nicknameEl.classList.remove("is-swapping");
        }, 180);
      }
      dealNickname(true);

      document.addEventListener("character:scene", (e) => {
        scene = (e as CustomEvent<{ id: SceneId }>).detail.id;
        dealNickname(true);
      });
      // Clicking the character waves (handled in the component) and deals a new nickname.
      document.addEventListener("character:tap", () => dealNickname(false));

      const emailLink = document.getElementById("copy-email")!;
      const emailText = emailLink.textContent;
      emailLink.addEventListener("click", async (e) => {
        if (!navigator.clipboard) return; // fall through to mailto:
        e.preventDefault();
        try {
          await navigator.clipboard.writeText("me@anandoghose.com");
          emailLink.textContent = "Copied!";
          setTimeout(() => (emailLink.textContent = emailText), 2000);
        } catch {
          window.location.href = "mailto:me@anandoghose.com";
        }
      });
    </script>
  </body>
</html>
