---
// Homepage: who Anando is on the left, a day in his life in 3D on the right.
// The character sets <html data-scene> and repaints the palette as his clock runs.
import Character3D from "../components/Character3D.astro";
import WorkFinder from "../components/WorkFinder.astro";
import { copy, tagline } from "../data/copy";
import { scenes } from "../data/scenes";
import { SITE, EMAIL, bio, summary, profiles } from "../data/profile";

const links = [
  { label: "Substack", href: "https://substack.com/@anandoghose", aria: "Follow me on Substack" },
  { label: "Medium", href: "https://medium.com/@anandoghose", aria: "Read me on Medium" },
  { label: "LinkedIn", href: "https://www.linkedin.com/in/anandoghose/", aria: "Connect with me on LinkedIn" },
  { label: "GitHub", href: "https://github.com/anandogs", aria: "See my code on GitHub" },
  { label: "Instagram", href: "https://www.instagram.com/anandoghose/", aria: "Follow me on Instagram" },
  { label: "YouTube", href: "https://www.youtube.com/@anandogs", aria: "Subscribe to my YouTube channel" },
];

// Who this site is about, for search engines: one person, this page is his profile.
const graph = {
  "@context": "https://schema.org",
  "@graph": [
    { "@type": "WebSite", "@id": `${SITE}/#website`, url: `${SITE}/`, name: "Anando Ghose", publisher: { "@id": `${SITE}/#person` } },
    {
      "@type": "ProfilePage",
      "@id": `${SITE}/#profilepage`,
      url: `${SITE}/`,
      isPartOf: { "@id": `${SITE}/#website` },
      // a full date-time with its zone: Google rejects a bare date here
      dateModified: new Date().toISOString(),
      mainEntity: { "@id": `${SITE}/#person` },
    },
    {
      "@type": "Person",
      "@id": `${SITE}/#person`,
      name: "Anando Ghose",
      alternateName: "anandogs",
      url: `${SITE}/`,
      email: EMAIL,
      jobTitle: "Automation and AI Agent Builder",
      description: bio[0],
      alumniOf: [{ "@type": "CollegeOrUniversity", name: "Indian School of Business", sameAs: "https://www.isb.edu/" }],
      knowsAbout: ["AI agents", "LangGraph", "AI infrastructure", "Finance automation", "Reporting automation", "Analytics", "AI training for teams", "Project management", "IoT for farming"],
      subjectOf: { "@id": `${SITE}/work#webpage` },
      sameAs: [...profiles.map((p) => p.href), "https://www.youtube.com/channel/UCb8LzmczkHjCz0Bhvgg-QjA"],
    },
  ],
};
---

<!doctype html>
<html lang="en" data-scene="work">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Anando Ghose | AI agents, automations, AI training</title>
    <meta name="title" content="Anando Ghose | AI agents, automations, AI training" />
    <meta
      name="description"
      content={summary}
    />
    <meta name="author" content="Anando Ghose" />
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://www.anandoghose.com/" />
    <meta
      property="og:title"
      content="Anando Ghose | AI agents, automations, AI training"
    />
    <meta
      property="og:description"
      content={summary}
    />
    <meta
      property="og:image"
      content="https://www.anandoghose.com/og.jpg"
    />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:url" content="https://www.anandoghose.com/" />
    <meta
      name="twitter:title"
      content="Anando Ghose | AI agents, automations, AI training"
    />
    <meta
      name="twitter:description"
      content={summary}
    />
    <meta
      name="twitter:image"
      content="https://www.anandoghose.com/og.jpg"
    />
    <link rel="canonical" href="https://www.anandoghose.com/" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />

    <link rel="icon" href="/favicon.png" type="image/png" />
    <link rel="shortcut icon" href="/favicon.png" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Caveat:wght@500&family=Inter:wght@400;600;800&display=swap"
      rel="stylesheet"
    />

    <script type="application/ld+json" set:html={JSON.stringify(graph)} />
  </head>
  <body>
    <div class="page">
      <main class="intro">
        <p class="eyebrow">Anando Ghose</p>
        <h1>
          Hi, I'm Anando,
          <span class="nickname" id="nickname">an automation sage</span>
        </h1>
        <p class="tagline">{tagline}</p>

        <div class="scene-copy">
          {
            scenes.map(({ id }) => (
              <section data-copy={id}>
                <p>{copy[id].body}</p>
                {copy[id].link && (
                  <a href={copy[id].link.href} target="_blank" rel="noopener noreferrer">
                    {copy[id].link.label} &rarr;
                  </a>
                )}
              </section>
            ))
          }
        </div>

        <a href="mailto:me@anandoghose.com" class="email" id="copy-email">Email me</a>

        <ul class="links">
          <li><a href="/work/">My work</a></li>
          {
            links.map((l) => (
              <li>
                <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.aria}>
                  {l.label}
                </a>
              </li>
            ))
          }
        </ul>

        <WorkFinder />
      </main>

      <div class="stage">
        <Character3D />
      </div>
    </div>

    <style is:global>
      /* The morning palette. Once the character is running it rewrites these on
         <html> many times a second to follow the clock through his day. */
      :root {
        --paper: #f1e7d6;
        --paper-deep: #ecdfc8;
        --glow: #fbf4e6;
        --sun-core: #fff9ea;
        --ink: #2b1c12;
        --ink-soft: #6a5443;
        --accent: #b23026;
        --sun-x: 58%;
        --sun-y: 26%;
      }

      * {
        margin: 0;
        padding: 0;
        box-sizing: border-box;
      }

      body {
        font-family: "Inter", system-ui, sans-serif;
        color: var(--ink);
        background: var(--paper);
        min-height: 100dvh;
      }
    </style>

    <style>
      .page {
        position: relative;
        display: grid;
        grid-template-columns: minmax(0, 34rem) minmax(0, 1fr);
        min-height: 100dvh;
        background: linear-gradient(180deg, var(--paper) 0%, var(--paper-deep) 100%);
        overflow: hidden;
      }

      .intro {
        align-self: center;
        padding: clamp(1.5rem, 5vw, 4.5rem);
        padding-right: 0;
        z-index: 1;
      }

      .eyebrow {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: var(--ink-soft);
        margin-bottom: 1.25rem;
      }

      h1 {
        font-size: clamp(2.4rem, 5.2vw, 4.25rem);
        font-weight: 800;
        line-height: 1.02;
        letter-spacing: -0.03em;
      }

      .nickname {
        display: block;
        min-height: 1.3em;
        margin-top: 0.15em;
        font-family: "Caveat", cursive;
        font-weight: 500;
        font-size: 0.8em;
        letter-spacing: 0;
        color: var(--accent);
        transition:
          opacity 0.18s ease,
          transform 0.18s ease;
      }

      .nickname.is-swapping {
        opacity: 0;
        transform: translateY(0.2em) rotate(-1deg);
      }

      .tagline {
        max-width: 29rem;
        margin-top: 1.5rem;
        font-size: 1.15rem;
        font-weight: 600;
        line-height: 1.45;
      }

      /* One block per scene, all in the same grid cell: the cell is as tall as the
         longest, so swapping them never moves the page. <html data-scene> picks
         which one shows. */
      .scene-copy {
        display: grid;
        max-width: 29rem;
        margin-top: 1rem;
      }

      .scene-copy section {
        grid-area: 1 / 1;
        opacity: 0;
        visibility: hidden;
        /* out first, then the next one in: the same beat as the nickname swap */
        transition:
          opacity 0.18s ease,
          visibility 0s 0.18s;
      }

      :global(:root[data-scene="work"]) .scene-copy [data-copy="work"],
      :global(:root[data-scene="farm"]) .scene-copy [data-copy="farm"],
      :global(:root[data-scene="surf"]) .scene-copy [data-copy="surf"] {
        opacity: 1;
        visibility: visible;
        transition:
          opacity 0.18s ease 0.18s,
          visibility 0s 0.18s;
      }

      .scene-copy h2 {
        font-size: 0.8rem;
        font-weight: 600;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--accent);
      }

      .scene-copy p {
        margin-top: 0.4rem;
        font-size: 1.05rem;
        line-height: 1.65;
        color: var(--ink-soft);
      }

      .scene-copy a {
        display: inline-block;
        margin-top: 0.5rem;
        color: var(--ink);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-underline-offset: 0.25em;
      }

      .scene-copy a:hover {
        color: var(--accent);
      }

      /* Nothing on stage to follow: show the whole day, one block after another. */
      :global(:root[data-character="failed"]) .scene-copy {
        display: block;
      }
      :global(:root[data-character="failed"]) .scene-copy section {
        opacity: 1;
        visibility: visible;
        transition: none;
      }
      :global(:root[data-character="failed"]) .scene-copy section + section {
        margin-top: 1.25rem;
      }

      .email {
        display: inline-block;
        margin-top: 1.75rem;
        font-size: 1.5rem;
        font-weight: 600;
        color: var(--ink);
        text-decoration: underline;
        text-decoration-color: var(--accent);
        text-decoration-thickness: 3px;
        text-underline-offset: 0.22em;
      }

      .email:hover {
        color: var(--accent);
      }

      .links {
        display: flex;
        flex-wrap: wrap;
        gap: 0.4rem 1.25rem;
        margin-top: 1.5rem;
        list-style: none;
      }

      .links a {
        color: var(--ink);
        font-weight: 600;
        font-size: 0.95rem;
        text-decoration: underline;
        text-decoration-color: color-mix(in srgb, var(--ink) 30%, transparent);
        text-underline-offset: 0.25em;
      }

      .links a:hover {
        color: var(--accent);
        text-decoration-color: currentColor;
      }

      a:focus-visible,
      button:focus-visible {
        outline: 3px solid var(--accent);
        outline-offset: 3px;
      }

      .stage {
        position: relative;
        height: 100dvh;
        min-height: 26rem;
      }

      /* The sun: a disc in its own glow, crossing the sky and sinking as his day goes on. */
      .stage::before {
        content: "";
        position: absolute;
        /* spills behind the text so the glow never ends on the stage's edge */
        inset: -35% 0 0 -35%;
        --x: calc(26% + var(--sun-x) * 0.74);
        --y: calc(26% + var(--sun-y) * 0.74);
        background: radial-gradient(45% 40% at var(--x) var(--y), var(--glow) 0%, transparent 70%);
        pointer-events: none;
      }

      /* The disc itself only shows outdoors: indoors at the desk it's just window light. */
      .stage::after {
        content: "";
        position: absolute;
        inset: -35% 0 0 -35%;
        --x: calc(26% + var(--sun-x) * 0.74);
        --y: calc(26% + var(--sun-y) * 0.74);
        background: radial-gradient(circle at var(--x) var(--y), var(--sun-core) 0 2.1rem, transparent 2.25rem);
        pointer-events: none;
        transition: opacity 0.6s ease;
      }
      :global(:root[data-scene="work"]) .stage::after {
        opacity: 0;
      }

      /* No WebGL, or the model never arrived: the page is simply the words. */
      :global(:root[data-character="failed"]) .stage {
        display: none;
      }
      :global(:root[data-character="failed"]) .page {
        grid-template-columns: minmax(0, 40rem);
        justify-content: center;
      }
      :global(:root[data-character="failed"]) .intro {
        padding-right: clamp(1.5rem, 5vw, 4.5rem);
      }

      @media (max-width: 820px) {
        .page {
          grid-template-columns: minmax(0, 1fr);
          grid-template-rows: auto 1fr;
        }

        .intro {
          padding: 1.75rem 1.25rem 0;
        }

        .eyebrow {
          margin-bottom: 0.75rem;
        }

        .tagline {
          margin-top: 1rem;
          font-size: 1.05rem;
        }

        .scene-copy {
          margin-top: 0.75rem;
        }

        .scene-copy p {
          font-size: 1rem;
          line-height: 1.55;
        }

        .email {
          margin-top: 1.1rem;
          font-size: 1.25rem;
        }

        .links {
          margin-top: 1rem;
        }

        .stage {
          height: auto;
          /* takes what the copy leaves of the first screen, so he stays above the
             fold on a tall phone; only short screens have to scroll to his feet */
          min-height: max(17rem, 34dvh, 100dvh - var(--intro-height, 100dvh));
        }

        :global(:root[data-character="failed"]) .intro {
          align-self: start;
          padding-bottom: 2rem;
        }
      }

      @media (prefers-reduced-motion: reduce) {
        .nickname {
          transition: none;
        }

        /* the stage stays on the morning, so the copy shows the whole day stacked */
        .scene-copy {
          display: block;
        }
        .scene-copy section {
          opacity: 1;
          visibility: visible;
          transition: none;
        }
        .scene-copy section + section {
          margin-top: 1.25rem;
        }
      }
    </style>

    <script>
      import { nicknames } from "../data/nicknames";
      import type { SceneId } from "../data/scenes";

      const nicknameEl = document.getElementById("nickname")!;
      let scene = (document.documentElement.dataset.scene ?? "work") as SceneId;
      let current = "";

      // Arriving in a scene deals one of its own nicknames; a tap can deal anything that fits.
      function dealNickname(onlyThisScene: boolean) {
        const own = nicknames.filter((n) => n.scene === scene);
        const pool = onlyThisScene && own.length ? own : nicknames.filter((n) => !n.scene || n.scene === scene);
        const fresh = pool.filter((n) => n.text !== current);
        const next = (fresh.length ? fresh : pool)[Math.floor(Math.random() * (fresh.length || pool.length))].text;
        current = next;
        nicknameEl.classList.add("is-swapping");
        setTimeout(() => {
          nicknameEl.textContent = next;
          nicknameEl.classList.remove("is-swapping");
        }, 180);
      }
      dealNickname(true);

      document.addEventListener("character:scene", (e) => {
        scene = (e as CustomEvent<{ id: SceneId }>).detail.id;
        dealNickname(true);
      });
      // Clicking the character waves (handled in the component) and deals a new nickname.
      document.addEventListener("character:tap", () => dealNickname(false));

      const emailLink = document.getElementById("copy-email")!;
      const emailText = emailLink.textContent;
      emailLink.addEventListener("click", async (e) => {
        if (!navigator.clipboard) return; // fall through to mailto:
        e.preventDefault();
        try {
          await navigator.clipboard.writeText("me@anandoghose.com");
          emailLink.textContent = "Copied!";
          setTimeout(() => (emailLink.textContent = emailText), 2000);
        } catch {
          window.location.href = "mailto:me@anandoghose.com";
        }
      });
    </script>
  </body>
</html>
