---
// Low-poly Anando going about a simulated day, paced by a clock that only shows
// as the wall clock over his desk:
// desk in the morning, farm from 1 pm, a sunset surf, then night sweeps round to
// morning again. Fills its parent; the parent decides the size. The timeline,
// the sky and every scene's facing and framing are in src/data/scenes.ts.
//
// Talks to the page through the document, so neither needs a handle on the other:
//   <html data-scene="work|farm|surf">   current scene
//   <html data-character="ready|failed"> set once the model is up, or never will be
//   --paper, --ink, --sun-x … on <html>  the palette of the current time of day
//   "character:scene" / "character:tap"  bubbling events, detail: { id }
import { scenes } from "../data/scenes";

---

<div class="character-stage" data-character-stage>
  <div
    class="character"
    data-character
    role="img"
    aria-label={`A low-poly 3D figure of Anando, ${scenes[0].alt}.`}
  >
    <canvas></canvas>
  </div>

  <p class="hint" data-hint aria-hidden="true">drag to spin · click to say hi</p>

  <button type="button" class="pause" data-pause aria-pressed="false" aria-label="Pause the animation">
    <svg viewBox="0 0 12 12" width="10" height="10" aria-hidden="true">
      <path class="icon-pause" d="M2 1h3v10H2zM7 1h3v10H7z"></path>
      <path class="icon-play" d="M2.5 1l8 5-8 5z"></path>
    </svg>
  </button>
</div>

<style>
  .character-stage {
    position: relative;
    width: 100%;
    height: 100%;
  }

  .character {
    position: absolute;
    inset: 0;
    cursor: grab;
    touch-action: pan-y;
    user-select: none;
    -webkit-user-select: none;
    /* ground that reaches the side of the stage dissolves instead of ending in a cut */
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 9%, #000 91%, transparent);
  }
  .character.is-dragging {
    cursor: grabbing;
  }

  canvas {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Nothing shows until the model is on screen, so a slow or failed load is just an empty stage. */
  .character-stage > * {
    opacity: 0;
    transition: opacity 0.6s ease;
  }
  .character-stage.is-ready > * {
    opacity: 1;
  }
  .character-stage:not(.is-ready) .pause {
    visibility: hidden;
  }

  .hint {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 1.1rem;
    margin: 0;
    text-align: center;
    font-family: "Caveat", cursive;
    font-size: 1.2rem;
    color: var(--ink-soft, #6a5443);
    pointer-events: none;
    /* stays readable where it overlaps the rug, grass or water */
    text-shadow:
      0 0 0.3em var(--paper, #f1e7d6),
      0 0 0.6em var(--paper, #f1e7d6);
  }
  .character-stage.is-ready .hint.is-hidden {
    opacity: 0;
  }

  .pause {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    border: 0;
    border-radius: 50%;
    background: color-mix(in srgb, var(--paper, #f1e7d6) 78%, transparent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--ink, #2b1c12) 14%, transparent);
    color: var(--ink, #2b1c12);
    cursor: pointer;
  }
  .pause:hover {
    background: var(--paper, #f1e7d6);
  }
  .pause:focus-visible {
    outline: 3px solid var(--accent, #b23026);
    outline-offset: 2px;
  }
  .pause svg {
    fill: currentColor;
  }
  .pause[aria-pressed="false"] .icon-play,
  .pause[aria-pressed="true"] .icon-pause {
    display: none;
  }

  @media (prefers-reduced-motion: reduce) {
    /* nothing moves by itself, so there is nothing to pause */
    .pause {
      display: none;
    }
    .character-stage > * {
      transition: none;
    }
  }
</style>

<script>
  import { scenes, night, sky, timing } from "../data/scenes";

  // ---- LEGACY FALLBACK (delete with its one use below once the per-scene models ship) ----
  // The single model that carries all three scenes' clips and props.
  const LEGACY_MODEL = "/models/anando.glb";
  // ------------------------------------------------------------------------------------

  const FOV = 28;
  const TAU = Math.PI * 2;
  // Share of the stage height kept below his feet; never less than the hint needs.
  const FEET_FROM_BOTTOM = 0.18;
  const FEET_MIN_PX = 64;

  const clamp = (v: number, lo: number, hi: number) => Math.min(hi, Math.max(lo, v));
  const smooth = (t: number) => t * t * (3 - 2 * t);
  const easeOutBack = (t: number) => 1 + 2.4 * Math.pow(t - 1, 3) + 1.4 * Math.pow(t - 1, 2);
  const rand = (lo: number, hi: number) => lo + Math.random() * (hi - lo);

  // The day as stretches of real time: each scene, then the night that wraps it round.
  // `scene` is an index into `scenes`, or -1 for the empty stage at night.
  const segments = (() => {
    let at = 0;
    const list = scenes.map((s, i) => ({ scene: i, from: s.from, to: scenes[i + 1]?.from ?? night.from, seconds: s.seconds }));
    list.push({ scene: -1, from: night.from, to: scenes[0].from + 24, seconds: night.seconds });
    return list.map((s) => ({ ...s, start: at, end: (at += s.seconds) }));
  })();

  async function mount(stage: HTMLElement) {
    const host = stage.querySelector<HTMLElement>("[data-character]")!;
    const canvas = host.querySelector("canvas")!;
    const hint = stage.querySelector<HTMLElement>("[data-hint]");
    const pauseButton = stage.querySelector<HTMLButtonElement>("[data-pause]");
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    const THREE = await import("three");
    const { GLTFLoader } = await import("three/addons/loaders/GLTFLoader.js");

    const renderer = new THREE.WebGLRenderer({ canvas, alpha: true, antialias: true });
    renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));
    renderer.shadowMap.enabled = true;

    const scene = new THREE.Scene();
    const camera = new THREE.PerspectiveCamera(FOV, 1, 0.1, 50);

    // ---- Oil paint ---------------------------------------------------------------------
    // The scene is drawn off screen, then repainted in two passes: a Kuwahara filter
    // melts it into flat colour, then it is covered in separate dabs of a loaded brush.
    // Each dab is one flat colour (the scene's, where the brush touched down), runs along
    // the nearest edge, and overlaps its neighbours and the silhouette. A dab never
    // covers something very unlike itself, which is what keeps eyes and stripes crisp.
    // A share of the dabs are re-laid every tick.
    const PAINT = {
      daub: 1.5, // Kuwahara tap spacing, CSS px: what shows between the dabs
      cell: 16, // CSS px between dabs; must stay ≥ 0.65 × length or dabs get cut off
      length: 25, // CSS px, give or take a third
      width: 11,
      keep: 0.15, // how different a colour must be for a dab to leave it alone (0–1)
      boilFps: 3,
    };
    const noiseData = new Uint8Array(256 * 256 * 4);
    for (let i = 0; i < noiseData.length; i++) noiseData[i] = Math.random() * 256;
    const noise = new THREE.DataTexture(noiseData, 256, 256);
    noise.wrapS = noise.wrapT = THREE.RepeatWrapping;
    noise.magFilter = noise.minFilter = THREE.LinearFilter;
    noise.needsUpdate = true;
    const drawn = new THREE.WebGLRenderTarget(1, 1, { type: THREE.HalfFloatType, samples: 4 });
    const daubed = new THREE.WebGLRenderTarget(1, 1, { type: THREE.HalfFloatType, depthBuffer: false });
    const paintVertex = `varying vec2 vUv; void main() { vUv = uv; gl_Position = vec4(position.xy, 0.0, 1.0); }`;
    const pass = (uniforms: Record<string, { value: unknown }>, fragmentShader: string) =>
      new THREE.ShaderMaterial({
        uniforms,
        vertexShader: paintVertex,
        fragmentShader,
        blending: THREE.NoBlending,
        depthTest: false,
        depthWrite: false,
        toneMapped: false,
      });
    const daubPass = pass(
      { tMap: { value: drawn.texture }, uPx: { value: new THREE.Vector2() }, uStep: { value: 1 } },
      `
      uniform sampler2D tMap; uniform vec2 uPx; uniform float uStep; varying vec2 vUv;
      void main() {
        vec4 best = vec4(0.0); float least = 1e9;
        for (int q = 0; q < 4; q++) {
          vec2 side = vec2(mod(float(q), 2.0), floor(float(q) / 2.0)) * 2.0 - 1.0;
          vec4 m = vec4(0.0), m2 = vec4(0.0);
          for (int i = 0; i < 3; i++) for (int j = 0; j < 3; j++) {
            vec4 c = texture2D(tMap, vUv + side * vec2(float(i), float(j)) * uStep * uPx);
            m += c; m2 += c * c;
          }
          m /= 9.0; m2 = abs(m2 / 9.0 - m * m);
          float spread = m2.r + m2.g + m2.b + m2.a;
          if (spread < least) { least = spread; best = m; }
        }
        gl_FragColor = best;
      }`,
    );
    const strokePass = pass(
      {
        tMap: { value: daubed.texture },
        tNoise: { value: noise },
        uRes: { value: new THREE.Vector2() },
        uDpr: { value: 1 },
        uCell: { value: PAINT.cell },
        uLength: { value: PAINT.length },
        uWidth: { value: PAINT.width },
        uKeep: { value: PAINT.keep },
        uTick: { value: 0 },
      },
      `
      uniform sampler2D tMap, tNoise; uniform vec2 uRes;
      uniform float uDpr, uCell, uLength, uWidth, uKeep, uTick; varying vec2 vUv;
      const vec3 LUMA = vec3(0.3, 0.59, 0.11);
      float tone(vec2 p) { vec4 c = texture2D(tMap, p / uRes); return dot(c.rgb, LUMA) + 0.5 * c.a; }
      vec4 hash4(vec2 p) {
        vec4 q = fract(p.xyxy * vec4(0.1031, 0.1030, 0.0973, 0.1099));
        q += dot(q, q.wzxy + 33.33);
        return fract((q.xxyz + q.yzzw) * q.zywx);
      }
      // to screen colour, eased toward a calm, slightly sun-bleached palette
      vec4 finish(vec4 c) {
        vec3 rgb = linearToOutputTexel(vec4(c.a > 1e-4 ? c.rgb / c.a : vec3(0.0), 1.0)).rgb;
        float l = dot(rgb, LUMA);
        rgb = mix(vec3(l), rgb, 1.06);
        rgb = mix(rgb, rgb * vec3(0.86, 0.93, 1.12), (1.0 - smoothstep(0.0, 0.5, l)) * 0.4);
        rgb = mix(rgb, vec3(0.96, 0.91, 0.8), 0.09);
        return vec4(clamp(rgb, 0.0, 1.0) * c.a, c.a);
      }
      void main() {
        vec2 p = vUv * uRes;
        float cell = uCell * uDpr;
        vec4 under = texture2D(tMap, vUv);
        vec4 paint = under;
        float top = -1.0;
        vec4 below = under; // the next dab down, which shows through the top one's soft edge
        float next = -1.0;
        float cover = 1.0;
        vec4 mark = vec4(0.0); // along, across (−1…1), and two numbers of the dab's own
        // two staggered grids of dabs; the one with the highest number lies on top
        for (int layer = 0; layer < 2; layer++) {
          float off = float(layer) * 0.5;
          vec2 home = floor(p / cell + off);
          for (int j = -1; j <= 1; j++) for (int i = -1; i <= 1; i++) {
            vec2 id = home + vec2(float(i), float(j));
            vec4 own = hash4(id + off * 142.6 + 7.0);
            // re-laid every fourth tick, each dab on its own beat
            vec4 lay = hash4(id + off * 91.7 + floor((uTick + own.w * 4.0) / 4.0) * 13.7);
            vec2 at = (id + 0.5 - off + (lay.xy - 0.5) * 0.8) * cell;
            vec4 c = texture2D(tMap, at / uRes);
            if (c.a < 0.5) continue;
            // along the nearest edge; across open colour, in slow swirls
            float e = 2.0 * uDpr;
            vec2 grad = vec2(tone(at + vec2(e, 0.0)) - tone(at - vec2(e, 0.0)), tone(at + vec2(0.0, e)) - tone(at - vec2(0.0, e)));
            float steep = length(grad);
            float turn = texture2D(tNoise, at / (uDpr * 256.0 * 240.0)).r * 9.0 + (lay.z - 0.5) * 0.35;
            vec2 swirl = vec2(cos(turn), sin(turn));
            vec2 along = vec2(-grad.y, grad.x) / max(steep, 1e-5);
            if (dot(along, swirl) < 0.0) along = -along;
            vec2 dir = normalize(mix(swirl, along, smoothstep(0.02, 0.14, steep)));
            vec2 rel = p - at;
            float u = dot(rel, dir);
            float v = dot(rel, vec2(-dir.y, dir.x));
            float halfL = uLength * uDpr * 0.5 * (0.7 + 0.6 * own.x);
            float halfW = uWidth * uDpr * 0.5 * (0.7 + 0.6 * own.y);
            // the bristles lift off unevenly, so the ends are ragged and the sides clean
            float ragged = texture2D(tNoise, vec2(v / (uDpr * 1.6 * 256.0), own.z)).r;
            if (abs(v) > halfW || abs(u) > halfL * (0.7 + 0.3 * ragged)) continue;
            if (under.a > 0.5 && distance(c.rgb / c.a, under.rgb / under.a) > uKeep) continue;
            float rank = fract(own.z * 7.31 + own.x);
            vec4 dab = vec4(c.rgb / c.a, 1.0) * (c.a > 0.9 ? 1.0 : c.a);
            if (rank < top) {
              if (rank > next) { next = rank; below = dab; }
              continue;
            }
            if (top >= 0.0) { next = top; below = paint; }
            top = rank;
            paint = dab;
            mark = vec4(u / halfL, v / halfW, lay.z, own.y);
            // a soft brush: the paint thins out toward the sides and the ends
            cover = smoothstep(1.0, 0.55, abs(v) / halfW) * smoothstep(1.0, 0.6, abs(u) / (halfL * (0.7 + 0.3 * ragged)));
          }
        }
        vec4 soft = finish(below);
        vec4 wet = finish(paint);
        if (top >= 0.0) {
          vec3 rgb = wet.a > 1e-4 ? wet.rgb / wet.a : vec3(0.0);
          // no two loads of the brush are quite the same colour
          rgb *= 1.0 + (mark.z - 0.5) * 0.13;
          rgb += (mark.w - 0.5) * vec3(0.05, 0.01, -0.05);
          // a little body to the paint: lit down one side, faint bristle tracks
          rgb += -mark.y * 0.02;
          rgb *= 1.0 + (texture2D(tNoise, vec2(mark.x * 0.02 + mark.z, mark.y * 0.035 + mark.w)).g - 0.5) * 0.06;
          wet = mix(soft, vec4(clamp(rgb, 0.0, 1.0) * wet.a, wet.a), cover);
        }
        gl_FragColor = wet;
      }`,
    );
    const easel = new THREE.Mesh(new THREE.PlaneGeometry(2, 2), daubPass);
    easel.frustumCulled = false;
    const easelCamera = new THREE.OrthographicCamera(-1, 1, 1, -1, 0, 1);
    const bufferSize = new THREE.Vector2();
    function sizePaint() {
      if (!painted) return;
      renderer.getDrawingBufferSize(bufferSize);
      const dpr = renderer.getPixelRatio();
      drawn.setSize(bufferSize.x, bufferSize.y);
      daubed.setSize(bufferSize.x, bufferSize.y);
      daubPass.uniforms.uPx.value.set(1 / bufferSize.x, 1 / bufferSize.y);
      daubPass.uniforms.uStep.value = PAINT.daub * dpr;
      strokePass.uniforms.uRes.value.copy(bufferSize);
      strokePass.uniforms.uDpr.value = dpr;
    }
    // off unless the page is opened with ?paint=1
    const painted = new URLSearchParams(location.search).get("paint") === "1";
    function paint(now: number) {
      if (!painted) return renderer.render(scene, camera);
      strokePass.uniforms.uTick.value = Math.floor(now * PAINT.boilFps);
      renderer.setRenderTarget(drawn);
      renderer.render(scene, camera);
      easel.material = daubPass;
      renderer.setRenderTarget(daubed);
      renderer.render(easel, easelCamera);
      easel.material = strokePass;
      renderer.setRenderTarget(null);
      renderer.render(easel, easelCamera);
    }

    const fill = new THREE.HemisphereLight();
    scene.add(fill);
    const sun = new THREE.DirectionalLight();
    sun.castShadow = true;
    sun.shadow.mapSize.set(1024, 1024);
    sun.shadow.camera.left = sun.shadow.camera.bottom = -2.4;
    sun.shadow.camera.right = sun.shadow.camera.top = 2.4;
    sun.shadow.radius = 6;
    sun.shadow.normalBias = 0.03;
    scene.add(sun);

    const shadowCatcher = new THREE.Mesh(
      new THREE.CircleGeometry(3.5, 48),
      // no depth write: it must not hide the troughs of the water that dip below it
      new THREE.ShadowMaterial({ opacity: 0.22, depthWrite: false }),
    );
    shadowCatcher.rotation.x = -Math.PI / 2;
    shadowCatcher.receiveShadow = true;
    scene.add(shadowCatcher);

    const flat = (color: number, extra = {}) =>
      new THREE.MeshStandardMaterial({ color, flatShading: true, roughness: 1, ...extra });

    const sceneIndex = (id: string) => scenes.findIndex((s) => s.id === id);
    const WORK = sceneIndex("work");
    const FARM = sceneIndex("farm");
    const SURF = sceneIndex("surf");

    // `seg` indexes `segments`; `index` is the scene on stage (-1 at night).
    const state = { seg: 0, index: 0, dayClock: 0, paused: false, waving: false, also: -1 };
    let time = 0;

    // ---- Things that pop in and out with a scene -------------------------------
    // The character himself, his props, and the bits of world built below.
    // `t` runs 0 (gone) → 1 (in place).
    interface Item {
      obj: any;
      scale: any;
      y: number;
      sink: number;
      t: number;
      wait: number;
    }
    const items: Item[][] = scenes.map(() => []);
    const addItem = (index: number, obj: any, sink = 0) => {
      obj.visible = false;
      items[index].push({ obj, scale: obj.scale.clone(), y: obj.position.y, sink, t: 0, wait: 0 });
    };
    // Stagger a scene's arrivals from the ground up.
    function queueItems(index: number, delay: number) {
      [...items[index]]
        .sort((a, b) => a.y - b.y)
        .forEach((item, i, list) => (item.wait = delay + (i / Math.max(1, list.length - 1)) * timing.stagger));
    }

    // ---- One character per scene ---------------------------------------------------
    // Each scene has its own model (own clothes, own props) and therefore its own
    // mixer: the files share bone names, so they can never share an animation root.
    interface Tile {
      obj: any;
      scale: any;
      y: number;
      t: number;
      emphasis: number;
      mats: any[];
    }
    // The little robot on his desk. Every part is optional; `rest` is how the model left it.
    interface Part {
      obj: any;
      rot: any;
      quat: any;
      scale: any;
    }
    interface Agent {
      head: Part | null;
      eyes: Part[];
      arms: Part[];
      antenna: Part | null;
      glow: any[];
      light: any;
      listen: any;
      chatting: boolean;
      /** 0 = busy at its own keyboard, 1 = turned to him */
      turn: number;
      yaw: number;
    }
    interface Actor {
      root: any;
      mixer: any;
      loop: any;
      wave: any;
      also: any[];
      active: any;
      hips: any;
      headFront: any;
      /** the bones that share the turn toward the viewer; `pose` is each one's rotation as animated, before that turn */
      lookChain: { bone: any; share: number; nod: number; pose: any }[];
      head: any;
      lids: any[];
      mouths: Record<string, any>;
      tiles: Tile[];
      sprouts: { obj: any; rest: any }[];
      leds: any[][];
      drips: { obj: any; due: number }[];
      spout: any;
      can: any;
      glow: any;
      clock: { hour: any; minute: any } | null;
      agent: Agent | null;
      /** the cat on his desk: `active` is whichever of her two clips is playing */
      pet: { rest: any; spell: any; active: any; head: any; pose: any; mode: "rest" | "spell" | "look"; until: number; done: boolean[] } | null;
    }
    const actors: (Actor | null)[] = scenes.map(() => null);
    const status: ("pending" | "ready" | "failed")[] = scenes.map(() => "pending");
    const current = () => (state.index >= 0 ? actors[state.index] : null);
    // what he goes back to after a wave: the scene loop, or the side activity that's on
    const baseAction = (actor: Actor) => (actor === current() && actor.also[state.also]) || actor.loop;
    function fadeTo(actor: Actor, next: any, seconds: number) {
      if (next === actor.active) return;
      next.reset().play();
      actor.active.crossFadeTo(next, seconds, false);
      actor.active = next;
    }

    function buildActor(index: number, gltf: any): Actor {
      const cfg = scenes[index];
      const root = gltf.scene;
      // yaw first, then tilt in his own frame, so the surf roll follows the board
      root.rotation.order = "YXZ";
      root.traverse((o: any) => {
        // a shared model also carries the other scenes' props: never show those here
        if (o.name.startsWith("Prop_") && !o.name.startsWith(cfg.props)) o.visible = false;
        if (!o.isMesh) return;
        // a clear cover (the junction-box lid) must not put what's under it in shadow
        o.castShadow = !o.material.transparent;
        o.receiveShadow = o.name.startsWith("Prop_");
        o.frustumCulled = false; // skinned bounds are unreliable
        // props are faceted low-poly; his body and face stay smooth
        // (textured props, like the cat, are modelled smooth too)
        o.material.flatShading = o.name.startsWith("Prop_") && !o.material.map;
        o.material.metalness = 0;
        o.material.roughness = 1;
        o.material.needsUpdate = true;
      });

      const tiles: Tile[] = [];
      const tilePrefix = cfg.also?.find((a) => a.tiles)?.tiles;
      const tileName = tilePrefix ? new RegExp(`^${tilePrefix}\\d+$`) : null;
      const propsRoot = root.getObjectByName(cfg.props);
      const rig = root.getObjectByName("AnandoRig");
      if (rig) addItem(index, rig, 0.3);
      root.traverse((o: any) => {
        if (tileName?.test(o.name)) {
          const mats: any[] = [];
          o.traverse((part: any) => {
            if (!part.isMesh) return;
            // own copy, so one tile can light up as the speaker without the others
            part.material = part.material.clone();
            mats.push(part.material);
          });
          o.visible = false;
          tiles.push({ obj: o, scale: o.scale.clone(), y: o.position.y, t: 0, emphasis: 0, mats });
        }
        if (o === propsRoot || !o.name.startsWith(cfg.props)) return;
        // tiles come and go with the call, not with the scene
        if (tilePrefix && o.name.startsWith(tilePrefix)) return;
        // nested prop parts ride along with their nearest prop ancestor
        if (o.parent !== propsRoot && o.parent.name.startsWith(cfg.props)) return;
        // only props standing on the ground sink into it; the can lives in his hand
        addItem(index, o, o.parent === propsRoot ? 0.25 : 0);
      });

      const mixer = new THREE.AnimationMixer(root);
      const clipAction = (name: string) => {
        const clip = gltf.animations.find((a: any) => a.name === name);
        return clip ? mixer.clipAction(clip) : null;
      };
      const loop = clipAction(cfg.clip);
      if (!loop) throw new Error(`${cfg.id} model has no "${cfg.clip}" clip`);
      const wave = clipAction(`${cfg.clip}_Hi`);
      if (wave) {
        wave.setLoop(THREE.LoopOnce, 1);
        wave.clampWhenFinished = true; // hold the last (rest) pose while the loop fades back in
      }
      // a side activity that needs tiles (the call) only runs if they exist
      const also = (cfg.also ?? []).map((a) => (!a.tiles || tiles.length ? clipAction(a.clip) : null));

      const lids = ["Blink_L", "Blink_R"].map((n) => root.getObjectByName(n)).filter(Boolean);
      lids.forEach((lid: any) => (lid.visible = false));
      const mouths = Object.fromEntries(
        ["Neutral", "Smile", "Open"].map((m) => [m, root.getObjectByName(`Mouth_${m}`)]).filter(([, o]) => o),
      );

      const sprouts: Actor["sprouts"] = [];
      root.traverse((o: any) => {
        if (/^Prop_Farm_Sprout\d+$/.test(o.name)) sprouts.push({ obj: o, rest: o.rotation.clone() });
      });

      // the self-watering kit: status LEDs on the controller, emitters along the drip line
      const leds: any[][] = [];
      const drips: Actor["drips"] = [];
      root.traverse((o: any) => {
        if (/^Prop_Farm_Drip\d+$/.test(o.name)) drips.push({ obj: o, due: rand(0, 2.5) });
        if (!/^Prop_Farm_Led\d+$/.test(o.name)) return;
        const mats: any[] = [];
        o.traverse((part: any) => {
          if (!part.isMesh) return;
          // own copy, so each LED blinks to its own rhythm
          part.material = part.material.clone();
          if (part.material.emissive.getHex() === 0) part.material.emissive.copy(part.material.color);
          mats.push(part.material);
        });
        leds[Number(o.name.match(/\d+$/)[0])] = mats;
      });

      // the agent buddy: found by name, so a model without one simply has no agent
      const agentPart = (name: string): Part | null => {
        const obj = root.getObjectByName(`Prop_Laptop_Agent${name}`);
        return obj ? { obj, rot: obj.rotation.clone(), quat: obj.quaternion.clone(), scale: obj.scale.clone() } : null;
      };
      const agentParts = {
        head: agentPart("Head"),
        eyes: [agentPart("Eye0"), agentPart("Eye1")].filter(Boolean) as Part[],
        arms: [agentPart("Arm0"), agentPart("Arm1")].filter(Boolean) as Part[],
        antenna: agentPart("Antenna"),
      };
      let agent: Agent | null = null;
      if (agentParts.head || agentParts.eyes.length || agentParts.arms.length) {
        // its terminal screen glows; own material copies so it can flicker
        const glow: any[] = [];
        for (const lit of [agentPart("Screen")]) {
          lit?.obj.traverse((part: any) => {
            if (!part.isMesh) return;
            part.material = part.material.clone();
            part.material.userData.rest = part.material.emissiveIntensity;
            glow.push(part.material);
          });
        }
        // the robot's side of the chat, timed to play alongside his clip from the same instant
        const listen = clipAction("Agent_Listen");
        if (listen) {
          listen.setLoop(THREE.LoopOnce, 1);
          listen.clampWhenFinished = true;
        }
        // its own screen faces away from the camera; this is that screen's light on its face
        const lightAt = root.getObjectByName("Prop_Laptop_AgentGlowPoint");
        const light = lightAt ? new THREE.PointLight(0xfff0dc, 0, 0.7, 0.5) : null;
        if (light) lightAt.add(light);
        agent = { ...agentParts, glow, light, listen, chatting: false, turn: 0, yaw: 0 };
      }

      // the screen on his face
      const glowPoint = root.getObjectByName("Prop_Laptop_GlowPoint");
      const glow = glowPoint ? new THREE.PointLight(0x9cc4ff, 0, 1.6, 0.5) : null;
      if (glow) glowPoint.add(glow);

      // The cat: two node clips on this same mixer. Each keys the scale of both her
      // meshes, so whichever clip is playing also decides which cat is showing.
      let pet: Actor["pet"] = null;
      const petRest = cfg.pet && clipAction(cfg.pet.rest);
      const petSpell = cfg.pet && clipAction(cfg.pet.spell);
      if (cfg.pet && petRest && petSpell) {
        const head = root.getObjectByName(cfg.pet.head);
        petRest.play();
        pet = { rest: petRest, spell: petSpell, active: petRest, head, pose: head?.quaternion.clone(), mode: "rest", until: 0, done: [] };
      }

      let clock: Actor["clock"] = null;
      if (index === WORK) {
        const wall = makeWallClock(cfg.homeYaw);
        root.add(wall.pivot);
        addItem(index, wall.face);
        clock = wall.hands;
      }
      if (index === FARM) {
        const meadow = makeMeadow();
        root.add(meadow);
        addItem(index, meadow);
      }

      const actor: Actor = {
        root,
        mixer,
        loop,
        wave,
        also,
        active: loop,
        hips: root.getObjectByName("Hips"),
        headFront: root.getObjectByName("headfront"),
        lookChain: cfg.turn.bones
          // looking up or down and the cock of the head are for the neck and head alone
          .map(([name, share]) => ({ bone: root.getObjectByName(name), share, nod: name === "neck" || name === "Head" ? 0.5 : 0 }))
          .filter((l) => l.bone)
          .map((l) => ({ ...l, pose: l.bone.quaternion.clone() })),
        head: root.getObjectByName("Head"),
        lids,
        mouths,
        tiles,
        sprouts,
        leds,
        drips,
        spout: root.getObjectByName("Spout"),
        can: root.getObjectByName("Prop_Farm_Can"),
        glow,
        clock,
        agent,
        pet,
      };
      mixer.addEventListener("finished", (e: any) => {
        if (e.action !== actor.active) return;
        if (actor === current()) {
          state.waving = false;
          smileUntil = time + 1.5;
        }
        fadeTo(actor, baseAction(actor), 0.3);
      });
      loop.play();
      root.visible = false;
      scene.add(root);
      return actor;
    }

    // ---- Desk: a wall clock, dust in the morning light --------------------------------
    // The only place the day's clock is ever shown. Real size (30 cm), hung where a
    // wall would be: behind him, above head height, off to one side of his head.
    function makeWallClock(homeYaw: number) {
      // undo the scene's resting turn, so the clock faces the camera when he is at rest
      const pivot = new THREE.Group();
      pivot.rotation.y = -homeYaw;
      const face = new THREE.Group();
      face.position.set(-0.72, 1.86, -0.7);
      pivot.add(face);
      const disc = (radius: number, depth: number, color: number, z: number, extra = {}) => {
        const mesh = new THREE.Mesh(new THREE.CylinderGeometry(radius, radius, depth, 20), flat(color, extra));
        mesh.rotation.x = Math.PI / 2;
        mesh.position.z = z;
        mesh.castShadow = true;
        face.add(mesh);
      };
      disc(0.158, 0.03, 0x4a3f3a, 0); // rim
      // white face, proud of the rim; lit a little from within so warm light can't turn it beige
      disc(0.145, 0.03, 0xffffff, 0.004, { emissive: 0xffffff, emissiveIntensity: 0.45 });
      const dark = flat(0x2b2422);
      for (let i = 0; i < 12; i++) {
        const quarter = i % 3 === 0;
        const tick = new THREE.Mesh(new THREE.BoxGeometry(quarter ? 0.012 : 0.006, quarter ? 0.03 : 0.018, 0.002), dark);
        const a = (i / 12) * TAU;
        tick.position.set(Math.sin(a) * 0.122, Math.cos(a) * 0.122, 0.02);
        tick.rotation.z = -a;
        face.add(tick);
      }
      const hand = (length: number, width: number, z: number) => {
        const turn = new THREE.Group();
        const mesh = new THREE.Mesh(new THREE.BoxGeometry(width, length, 0.003), dark);
        mesh.position.set(0, length / 2 - 0.015, z); // a short tail past the pin
        turn.add(mesh);
        face.add(turn);
        return turn;
      };
      const hands = { hour: hand(0.085, 0.014, 0.023), minute: hand(0.125, 0.009, 0.027) };
      disc(0.012, 0.012, 0x2b2422, 0.026); // pin
      return { pivot, face, hands };
    }

    // ---- Desk: dust in the morning light ----------------------------------------------
    const MOTES = 14;
    const motes = new THREE.InstancedMesh(
      new THREE.OctahedronGeometry(1, 0),
      new THREE.MeshBasicMaterial({ color: 0xfff4cf, transparent: true, opacity: 0.8 }),
      MOTES,
    );
    motes.frustumCulled = false;
    const moteSeeds = Array.from({ length: MOTES }, () => ({
      x: rand(-1.1, 0.5),
      y: rand(0.5, 1.9),
      z: rand(-0.3, 0.7),
      phase: rand(0, TAU),
      speed: rand(0.15, 0.4),
    }));
    scene.add(motes);
    addItem(WORK, motes);

    // ---- Farm: a patch of meadow, butterflies, water from the can -----------------
    function makeMeadow() {
      const meadow = new THREE.Group();
      const grassGeo = new THREE.CircleGeometry(1.45, 13);
      for (let i = 1; i < grassGeo.attributes.position.count; i++) {
        const k = rand(0.9, 1.06);
        grassGeo.attributes.position.setXY(
          i,
          grassGeo.attributes.position.getX(i) * k,
          grassGeo.attributes.position.getY(i) * k,
        );
      }
      const grass = new THREE.Mesh(grassGeo, flat(0xa3c56f));
      grass.rotation.x = -Math.PI / 2;
      grass.position.set(-0.1, 0.004, 0.15);
      grass.scale.y = 0.85; // a little shallower front to back
      grass.receiveShadow = true;
      meadow.add(grass);
      const tuftGeo = new THREE.ConeGeometry(0.04, 0.16, 4);
      const tuftMat = flat(0x6f9e4a);
      for (let i = 0; i < 9; i++) {
        // behind and beside him, clear of the seed bed in front
        const a = rand(Math.PI * 0.05, Math.PI * 0.95) + Math.PI;
        const r = rand(0.75, 1.25);
        for (let j = 0; j < 3; j++) {
          const tuft = new THREE.Mesh(tuftGeo, tuftMat);
          tuft.position.set(Math.cos(a) * r + rand(-0.05, 0.05), 0.07, Math.sin(a) * r + rand(-0.05, 0.05));
          tuft.rotation.set(rand(-0.3, 0.3), rand(0, TAU), rand(-0.3, 0.3));
          tuft.scale.setScalar(rand(0.7, 1.2));
          tuft.castShadow = true;
          meadow.add(tuft);
        }
      }
      return meadow;
    }

    const wingGeo = new THREE.BufferGeometry();
    wingGeo.setAttribute(
      "position",
      new THREE.Float32BufferAttribute([0, 0, 0.04, 0, 0, -0.035, 0.08, 0, -0.05, 0, 0, 0.04, 0.08, 0, -0.05, 0.06, 0, 0.05], 3),
    );
    wingGeo.computeVertexNormals();
    const butterflies = [0xf2a33a, 0xfbf3e2].map((color, i) => {
      const body = new THREE.Group();
      const mat = flat(color, { side: THREE.DoubleSide });
      const right = new THREE.Mesh(wingGeo, mat);
      const left = new THREE.Mesh(wingGeo, mat);
      left.scale.x = -1;
      body.add(right, left);
      scene.add(body);
      addItem(FARM, body);
      return { body, right, left, phase: i * 2.4, last: new THREE.Vector3() };
    });

    // ---- Surf: faceted water that the board actually rides -------------------------
    const WATER_R = 1.8;
    const WATER_SEG = 22;
    const swell = (x: number, z: number, t: number) =>
      0.045 * Math.sin(1.9 * x + 0.8 * z + 2.2 * t) +
      0.03 * Math.sin(-1.1 * x + 2.7 * z + 1.6 * t) +
      0.014 * Math.sin(4.1 * x - 1.3 * z + 3.3 * t);
    const grid = new THREE.PlaneGeometry(WATER_R * 2, WATER_R * 2, WATER_SEG, WATER_SEG);
    grid.rotateX(-Math.PI / 2);
    for (let i = 0; i < grid.attributes.position.count; i++) {
      // knock the grid off-square so the facets don't read as a mesh
      const j = (WATER_R * 2) / WATER_SEG / 3;
      grid.attributes.position.setX(i, grid.attributes.position.getX(i) + rand(-j, j));
      grid.attributes.position.setZ(i, grid.attributes.position.getZ(i) + rand(-j, j));
    }
    // un-shared vertices, so every triangle can carry its own colour
    const waterGeo = grid.toNonIndexed();
    const waterPos = waterGeo.attributes.position;
    const waterColor = new THREE.BufferAttribute(new Float32Array(waterPos.count * 4), 4);
    waterGeo.setAttribute("color", waterColor);
    const faceTint = new Float32Array(waterPos.count / 3);
    for (let i = 0; i < waterPos.count; i++) {
      const r = Math.hypot(waterPos.getX(i), waterPos.getZ(i)) / WATER_R;
      // fade out before the edge so the pool never ends in a hard line
      waterColor.setW(i, 0.95 * (1 - smooth(clamp((r - 0.7) / 0.3, 0, 1))));
      if (i % 3 === 0) faceTint[i / 3] = rand(-0.12, 0.12);
    }
    const water = new THREE.Mesh(
      waterGeo,
      flat(0xffffff, { vertexColors: true, transparent: true, depthWrite: false, roughness: 0.9 }),
    );
    water.receiveShadow = true;
    scene.add(water);
    addItem(SURF, water);
    const deep = new THREE.Color(0x1d8fae);
    const shallow = new THREE.Color(0x7fd8d0);
    const foam = new THREE.Color(0xf4fffb);
    const tint = new THREE.Color();
    function updateWater(t: number) {
      for (let f = 0; f < waterPos.count; f += 3) {
        let mean = 0;
        for (let i = f; i < f + 3; i++) {
          const h = swell(waterPos.getX(i), waterPos.getZ(i), t);
          waterPos.setY(i, h);
          mean += h / 3;
        }
        const crest = clamp(mean / 0.075, -1, 1) * 0.5 + 0.5 + faceTint[f / 3];
        tint.copy(deep).lerp(shallow, clamp(crest, 0, 1));
        if (crest > 0.9) tint.lerp(foam, clamp((crest - 0.9) / 0.15, 0, 1));
        for (let i = f; i < f + 3; i++) waterColor.setXYZ(i, tint.r, tint.g, tint.b);
      }
      waterPos.needsUpdate = true;
      waterColor.needsUpdate = true;
    }
    updateWater(0);

    // Small faceted bits that fly and fall: spray off the board, water from the can.
    function makeParticles(count: number, color: number, size: number) {
      const mesh = new THREE.InstancedMesh(new THREE.TetrahedronGeometry(1), flat(color, { roughness: 0.6 }), count);
      mesh.frustumCulled = false;
      const pool = Array.from({ length: count }, () => ({
        pos: new THREE.Vector3(),
        vel: new THREE.Vector3(),
        age: 0,
        life: 0,
      }));
      const m = new THREE.Matrix4();
      const q = new THREE.Quaternion();
      const s = new THREE.Vector3();
      let next = 0;
      scene.add(mesh);
      return {
        spawn(pos: any, vel: any, life: number) {
          const p = pool[next];
          next = (next + 1) % count;
          p.pos.copy(pos);
          p.vel.copy(vel);
          p.age = 0;
          p.life = life;
        },
        update(dt: number, gravity: number, floor: number) {
          pool.forEach((p, i) => {
            if (p.age < p.life) {
              p.age += dt;
              p.vel.y -= gravity * dt;
              p.pos.addScaledVector(p.vel, dt);
              if (p.pos.y < floor) p.age = p.life;
            }
            const k = p.age < p.life ? Math.sqrt(Math.sin((Math.PI * p.age) / p.life)) : 0;
            mesh.setMatrixAt(i, m.compose(p.pos, q, s.setScalar(size * k)));
          });
          mesh.instanceMatrix.needsUpdate = true;
        },
      };
    }
    const spray = makeParticles(36, 0xffffff, 0.03);
    const drops = makeParticles(28, 0x69bfe6, 0.022);
    const drips = makeParticles(16, 0x69bfe6, 0.011);
    drips.update(0, 0, 0);
    spray.update(0, 0, 0);
    drops.update(0, 0, 0);

    // a burst that covers him leaving and arriving
    const puff = makeParticles(22, 0xfff7e6, 0.04);
    puff.update(0, 0, 0);

    // ---- Load: the first scene gates first paint, the rest follow in the background ----
    const loader = new GLTFLoader();
    async function load(index: number, url: string) {
      actors[index] = buildActor(index, await loader.loadAsync(url));
      status[index] = "ready";
    }
    let modelFor = (index: number) => scenes[index].model;
    try {
      await load(0, modelFor(0));
    } catch {
      // ---- LEGACY FALLBACK: no per-scene models yet, so one copy of the old model per scene ----
      modelFor = () => LEGACY_MODEL;
      await load(0, modelFor(0));
      // -----------------------------------------------------------------------------------------
    }
    scenes.forEach((_, i) => {
      // a scene whose model never arrives is skipped when its time comes
      if (i > 0) load(i, modelFor(i)).catch(() => (status[i] = "failed"));
    });

    // ---- The day -------------------------------------------------------------------------
    function announce() {
      const cfg = scenes[state.index];
      if (cfg) document.documentElement.dataset.scene = cfg.id;
      host.setAttribute(
        "aria-label",
        cfg ? `A low-poly 3D figure of Anando, ${cfg.alt}.` : "An empty stage: night is passing until Anando's next morning.",
      );
    }

    const puffAt = new THREE.Vector3();
    let puffDue = Infinity;
    function goTo(index: number) {
      const leaving = current();
      state.index = index;
      state.waving = false;
      state.also = -1;
      if (leaving) {
        // he goes off to get changed in a puff …
        (leaving.hips ?? leaving.root).getWorldPosition(puffAt);
        puffDue = time + timing.propsOut * 0.5;
      }
      const actor = current();
      if (actor) {
        actor.mixer.stopAllAction();
        actor.active = actor.loop;
        actor.loop.reset().play();
        if (actor.pet) {
          Object.assign(actor.pet, { active: actor.pet.rest, mode: "rest", done: [] });
          actor.pet.rest.reset().play();
        }
        queueItems(index, leaving ? timing.propsInDelay : 0.15);
        if (!leaving) {
          // … or, in the morning, simply turns up in one
          puffAt.set(0, 0.9, 0);
          puffDue = time + 0.15;
        }
        if (index === SURF) nextSmile = Math.min(nextSmile, time + 1);
        stage.dispatchEvent(new CustomEvent("character:scene", { bubbles: true, detail: { id: scenes[index].id } }));
      }
      announce();
    }

    function advanceDay(dt: number) {
      const seg = segments[state.seg];
      state.dayClock += dt;
      if (state.dayClock < seg.end) return;
      let next = (state.seg + 1) % segments.length;
      while (segments[next].scene >= 0 && status[segments[next].scene] === "failed") next = (next + 1) % segments.length;
      if (segments[next].scene >= 0 && status[segments[next].scene] === "pending") {
        // its model is still on the way: stay where we are a little longer, clock held
        state.dayClock = seg.end;
        return;
      }
      state.seg = next;
      state.dayClock = segments[next].start;
      goTo(segments[next].scene);
    }
    // Clock time now, in hours since midnight of the day's first morning (so 26 = 2 am).
    function clockNow() {
      const seg = segments[state.seg];
      const p = clamp((state.dayClock - seg.start) / seg.seconds, 0, 1);
      // night is a sweep of the hands: ease in and out of it
      return seg.from + (seg.to - seg.from) * (seg.scene < 0 ? smooth(p) : p);
    }

    function sayHi() {
      const actor = current();
      if (!actor?.wave || state.waving || reduceMotion || state.paused) return;
      state.waving = true;
      // The clip swaps his hand for a posed one 0.17 s in, by scale. A longer blend
      // from the loop would still be under way then and show both hands part-size.
      fadeTo(actor, actor.wave, 0.15);
      // a blink as he notices you
      blinkUntil = time + 0.13;
      nextBlink = time + rand(2.5, 4.5);
    }

    // ---- The cat ---------------------------------------------------------------------------
    // Mostly asleep; a grooming spell when the clock says so (timed for while he is
    // turned to the agent), a whole number of loops long. Her two poses are two meshes
    // swapped by scale, so the change is a quick shrink-and-pop, like the props.
    function petTo(actor: Actor, action: any) {
      const pet = actor.pet!;
      if (action === pet.active) return;
      action.reset().play();
      action.timeScale = 1;
      pet.active.crossFadeTo(action, 0.2, false);
      pet.active = action;
    }
    function petLife(actor: Actor, clock: number) {
      const pet = actor.pet!;
      const cfg = scenes[state.index].pet!;
      if (pet.mode === "look") {
        if (!state.waving && noticed.w < 0.05) {
          pet.mode = "rest";
          petTo(actor, pet.rest);
        }
      } else if (pet.mode === "spell") {
        if (time >= pet.until) {
          pet.mode = "rest";
          petTo(actor, pet.rest);
        }
      } else {
        const due = cfg.spells.findIndex((s, i) => !pet.done[i] && clock >= s.at && clock < s.at + 0.2);
        if (due >= 0) {
          pet.done[due] = true;
          pet.mode = "spell";
          pet.until = time + cfg.spells[due].loops * pet.spell.getClip().duration - 0.2;
          petTo(actor, pet.spell);
        }
      }
      // on a tap she looks out at the visitor along with him (her head faces +Z at rest)
      const w = pet.mode === "look" ? clamp(noticed.w, 0, 1) : 0;
      if (!w || !pet.head) return;
      pet.head.parent.updateWorldMatrix(true, false);
      pet.head.parent.getWorldQuaternion(parentQ);
      pet.head.getWorldPosition(headAt);
      facing.set(0, 0, 1).applyQuaternion(pet.head.getWorldQuaternion(worldTurn));
      toLens.copy(camera.position).sub(headAt);
      const yaw = clamp(wrapPi(Math.atan2(toLens.x, toLens.z) - Math.atan2(facing.x, facing.z)), -1.1, 1.1) * w;
      worldTurn.setFromAxisAngle(yAxis, yaw);
      pet.head.quaternion.premultiply(partTurn.copy(parentQ).invert().multiply(worldTurn).multiply(parentQ));
    }

    // ---- Noticing the visitor ---------------------------------------------------------------
    // A tap makes him look out of the screen: while the wave plays he turns to the real
    // camera, wherever the view has been spun to. Only he turns, never the set: the turn
    // is shared up the scene's `turn.bones` so the face ends square to the lens, and if
    // the lens is further round than a person could twist, he stops short of it.
    // `w` is how far into that he is; a spring, so it snaps in with a little overshoot.
    const noticed = { w: 0, speed: 0, side: 1 };
    const yAxis = new THREE.Vector3(0, 1, 0);
    const zAxis = new THREE.Vector3(0, 0, 1);
    const headAt = new THREE.Vector3();
    const facing = new THREE.Vector3();
    const toLens = new THREE.Vector3();
    const parentQ = new THREE.Quaternion();
    const worldTurn = new THREE.Quaternion();
    const partTurn = new THREE.Quaternion();
    const wrapPi = (a: number) => a - Math.round(a / TAU) * TAU;
    function notice(actor: Actor, dt: number) {
      // let go a little before the wave ends, so he is back on his task as it finishes
      const on = state.waving && actor.wave && actor.wave.time < actor.wave.getClip().duration - 0.45 ? 1 : 0;
      noticed.speed += ((on - noticed.w) * 260 - noticed.speed * 22) * dt;
      noticed.w += noticed.speed * dt;
      if (!on && Math.abs(noticed.w) < 0.002 && Math.abs(noticed.speed) < 0.02) noticed.w = noticed.speed = 0;
      const w = noticed.w;
      if (w === 0 || !actor.head || !actor.headFront) return;

      // where his face points as animated, and where the lens is from his head
      actor.root.updateMatrixWorld(true);
      actor.head.getWorldPosition(headAt);
      actor.headFront.getWorldPosition(facing).sub(headAt).normalize();
      toLens.copy(camera.position).sub(headAt).normalize();
      let yaw = wrapPi(Math.atan2(toLens.x, toLens.z) - Math.atan2(facing.x, facing.z));
      // with the lens right behind him, don't flip-flop over which way round to turn
      if (Math.abs(yaw) > 2.6) yaw = Math.abs(yaw) * noticed.side;
      else noticed.side = Math.sign(yaw) || 1;
      const limit = scenes[state.index].turn.limit;
      const neckYaw = clamp(yaw, -limit, limit) * w;
      const neckPitch = clamp(Math.asin(clamp(facing.y, -1, 1)) - Math.asin(clamp(toLens.y, -1, 1)), -0.5, 0.5) * w;
      for (const { bone, share, nod } of actor.lookChain) {
        bone.parent.updateWorldMatrix(true, false);
        bone.parent.getWorldQuaternion(parentQ);
        worldTurn.setFromAxisAngle(yAxis, neckYaw * share);
        worldTurn.multiply(partTurn.setFromAxisAngle(xAxis, neckPitch * nod));
        // a slight cock of the head, the way you look at someone you've just spotted
        worldTurn.multiply(partTurn.setFromAxisAngle(zAxis, 0.07 * w * nod * noticed.side));
        // express the world-space turn in the bone's parent space
        bone.quaternion.premultiply(partTurn.copy(parentQ).invert().multiply(worldTurn).multiply(parentQ));
      }
    }

    pauseButton?.addEventListener("click", () => {
      state.paused = !state.paused;
      pauseButton.setAttribute("aria-pressed", String(state.paused));
      pauseButton.setAttribute("aria-label", state.paused ? "Play the animation" : "Pause the animation");
      schedule();
    });

    // Drag to spin; a press that never moves counts as a tap.
    const spin = { yaw: scenes[0].homeYaw, velocity: 0, dragging: false };
    let downX = 0;
    let lastX = 0;
    let moved = 0;
    host.addEventListener("pointerdown", (e) => {
      spin.dragging = true;
      downX = lastX = e.clientX;
      moved = 0;
      host.classList.add("is-dragging");
      host.setPointerCapture(e.pointerId);
      hint?.classList.add("is-hidden");
    });
    host.addEventListener("pointermove", (e) => {
      if (!spin.dragging || reduceMotion) return;
      const dx = e.clientX - lastX;
      lastX = e.clientX;
      moved = Math.max(moved, Math.abs(e.clientX - downX));
      spin.yaw += dx * 0.012;
      spin.velocity = dx * 0.012;
    });
    const release = (tapped: boolean) => {
      if (!spin.dragging) return;
      spin.dragging = false;
      host.classList.remove("is-dragging");
      if (!tapped || state.index < 0) return;
      sayHi();
      host.dispatchEvent(
        new CustomEvent("character:tap", { bubbles: true, detail: { id: scenes[state.index].id } }),
      );
    };
    host.addEventListener("pointerup", () => release(moved < 6));
    // the browser took the gesture for a scroll: not a tap
    host.addEventListener("pointercancel", () => release(false));

    // ---- Camera ----------------------------------------------------------------------
    const frameNow = { ...scenes[0].frame };
    function placeCamera() {
      const h = host.clientHeight || 1;
      const t = Math.tan(THREE.MathUtils.degToRad(FOV / 2));
      const feet = clamp(FEET_MIN_PX / h, FEET_FROM_BOTTOM, 0.26);
      // a small push-in while he is looking back at the visitor
      const dist = Math.max(frameNow.height / (1 - feet) / 2 / t, frameNow.width / 2 / (t * camera.aspect)) * (1 - 0.025 * noticed.w);
      // Look slightly down so the ground reads as ground, and aim at the height that
      // lands his feet on a fixed line near the bottom, however tall the stage is.
      const pitch = THREE.MathUtils.degToRad(frameNow.pitch);
      const n = (1 - 2 * feet) * t;
      const aimY = (n * dist) / (Math.cos(pitch) - n * Math.sin(pitch));
      camera.position.set(0, aimY + dist * Math.sin(pitch), dist * Math.cos(pitch));
      camera.lookAt(0, aimY, 0);
      camera.updateProjectionMatrix();
    }

    // ---- Sky: light and page colours follow the clock ------------------------------------
    const pageVars = { paper: "--paper", paperDeep: "--paper-deep", glow: "--glow", sunCore: "--sun-core", ink: "--ink", inkSoft: "--ink-soft", accent: "--accent" };
    const keys = sky.map((k) => ({
      ...k,
      sunColor: new THREE.Color(k.sun.color),
      sunPos: new THREE.Vector3().fromArray(k.sun.position),
      fillColor: new THREE.Color(k.fill.color),
      groundColor: new THREE.Color(k.fill.ground),
      pageColors: Object.fromEntries(Object.entries(k.page).map(([name, hex]) => [name, new THREE.Color(hex)])),
    }));
    const pageTint = new THREE.Color();
    let pageDue = 0;
    function applySky(clock: number) {
      const i = Math.max(0, keys.findIndex((k, n) => clock < (keys[n + 1]?.at ?? Infinity)));
      const a = keys[i];
      const b = keys[i + 1] ?? a;
      const f = b === a ? 0 : clamp((clock - a.at) / (b.at - a.at), 0, 1);
      const mix = (x: number, y: number) => x + (y - x) * f;
      sun.color.lerpColors(a.sunColor, b.sunColor, f);
      sun.intensity = mix(a.sun.intensity, b.sun.intensity);
      sun.position.lerpVectors(a.sunPos, b.sunPos, f);
      fill.color.lerpColors(a.fillColor, b.fillColor, f);
      fill.groundColor.lerpColors(a.groundColor, b.groundColor, f);
      fill.intensity = mix(a.fill.intensity, b.fill.intensity);
      // the page only needs a handful of repaints a second to look continuous
      if (time < pageDue) return;
      pageDue = time + 0.08;
      const style = document.documentElement.style;
      for (const [name, css] of Object.entries(pageVars)) {
        style.setProperty(css, `#${pageTint.lerpColors(a.pageColors[name], b.pageColors[name], f).getHexString()}`);
      }
      style.setProperty("--sun-x", `${mix(a.disc.x, b.disc.x).toFixed(2)}%`);
      style.setProperty("--sun-y", `${mix(a.disc.y, b.disc.y).toFixed(2)}%`);
    }

    // ---- Face: one mouth at a time, and a blink ---------------------------------------
    const showMouth = (actor: Actor, want: string) => {
      const shown = actor.mouths[want] ? want : "Neutral";
      for (const m in actor.mouths) actor.mouths[m].visible = m === shown;
    };
    let smileUntil = 0;
    let nextSmile = rand(6, 12);
    let nextBlink = rand(2, 4);
    let blinkUntil = 0;
    // who has the floor in a conversation: -1 is him, otherwise a call tile (or the buddy)
    const talk = { who: -1, until: 0, open: false, flipAt: 0 };
    const activity = () => scenes[state.index]?.also?.[state.also];
    const talking = () => !!activity()?.talks;
    // he talks in bursts, then listens while one of the others has the floor
    function converse(others: number) {
      if (time < talk.until) return;
      const listening = talk.who === -1;
      talk.who = listening ? Math.floor(rand(0, Math.max(1, others))) : -1;
      talk.until = time + (listening ? rand(0.5, 1.5) : rand(1.2, 2.8));
    }
    function face(actor: Actor) {
      if (reduceMotion) return showMouth(actor, "Neutral");
      if (time > nextBlink) {
        blinkUntil = time + 0.12;
        nextBlink = time + rand(3, 6);
      }
      for (const lid of actor.lids) lid.visible = time < blinkUntil;

      const surfing = state.index === SURF;
      if (time > nextSmile) {
        // a passing smile now and then; on the board he's grinning more often than not
        smileUntil = Math.max(smileUntil, time + (surfing ? rand(3, 6) : 2));
        nextSmile = smileUntil + (surfing ? rand(1.5, 3) : rand(10, 20));
      }
      if (state.waving || time < smileUntil) return showMouth(actor, "Smile");
      if (talking() && talk.who === -1) {
        if (time > talk.flipAt) {
          // syllables: 4–8 mouth changes a second
          talk.open = !talk.open;
          talk.flipAt = time + rand(0.125, 0.25);
        }
        return showMouth(actor, talk.open ? "Open" : "Neutral");
      }
      showMouth(actor, "Neutral");
    }

    // The robot's own life: it types and blinks away by itself, and when he turns to
    // talk to it, it stops, turns its head to him and nods along.
    let agentBlink = rand(1, 3);
    const xAxis = new THREE.Vector3(1, 0, 0);
    const buddyTurn = new THREE.Quaternion();
    function buddy(actor: Actor, dt: number) {
      const a = actor.agent!;
      const chatting = actor === current() && !!activity()?.buddy && !state.waving;
      if (chatting !== a.chatting) {
        a.chatting = chatting;
        if (chatting) a.listen?.reset().fadeIn(0.3).play();
        else a.listen?.fadeOut(0.3);
      }
      a.turn += ((chatting ? 1 : 0) - a.turn) * (1 - Math.exp(-dt * 5));
      // once it has faded out, let go of the nodes so the idle motion below can have them back
      if (a.listen && !chatting && a.turn < 0.02 && a.listen.isRunning()) a.listen.stop();
      const scripted = !!a.listen?.isRunning();
      const itSpeaks = chatting && talk.who !== -1;

      if (time > agentBlink + 0.11) agentBlink = time + rand(1.5, 4.5);
      for (const eye of a.eyes) eye.obj.scale.y = eye.scale.y * (time > agentBlink ? 0.12 : 1);
      // screen flicker, brighter when it has something to say
      const flicker = 0.85 + 0.15 * Math.sin(time * 23) * Math.sin(time * 7.3) + (itSpeaks ? 0.5 + 0.3 * Math.sin(time * 19) : 0);
      for (const mat of a.glow) mat.emissiveIntensity = (mat.userData.rest || 1) * flicker;
      if (a.light) a.light.intensity = 0.3 * flicker * smooth(presence[WORK]);
      if (scripted) return; // its clip is moving the head, arms and antenna
      const looks = actor === current() ? clamp(noticed.w, 0, 1) : 0;

      a.arms.forEach((arm, i) => {
        // alternate taps at its tablet, on top of the reach the model rests in
        buddyTurn.setFromAxisAngle(xAxis, Math.sin(time * 13 + i * Math.PI) * 0.1 * (1 - a.turn) * (1 - looks));
        arm.obj.quaternion.copy(arm.quat).multiply(buddyTurn);
      });
      if (a.antenna) a.antenna.obj.rotation.z = a.antenna.rot.z + Math.sin(time * 3.1) * 0.08;
      if (a.head) {
        const head = a.head.obj;
        if (chatting && actor.head) {
          // no clip for its side: work out where he is as a turn of its neck (it faces +Z at rest)
          head.parent.worldToLocal(actor.head.getWorldPosition(v)).sub(head.position);
          // a part turn only, so its eyes stay in view of the camera
          a.yaw = clamp(Math.atan2(v.x, v.z), -0.45, 0.45);
        }
        // when he notices the visitor, so does it: hands off the keys, face up to the lens
        head.parent.worldToLocal(v.copy(camera.position)).sub(head.position);
        const lensYaw = clamp(Math.atan2(v.x, v.z), -0.6, 0.6);
        head.rotation.y = a.head.rot.y + (a.yaw * a.turn + Math.sin(time * 0.8) * 0.1 * (1 - a.turn)) * (1 - looks) + lensYaw * looks;
        head.rotation.x = a.head.rot.x + Math.sin(time * 4.5) * 0.09 * a.turn * (1 - looks) - 0.12 * looks;
      }
    }

    function call(actor: Actor, dt: number) {
      const on = actor === current() && !!activity()?.tiles;
      actor.tiles.forEach((tile, i) => {
        // same pop as the props, one after another
        const rate = on ? timing.propsIn + i * 0.25 : timing.propsOut;
        tile.t = clamp(tile.t + (on ? 1 : -1) * (dt / rate), 0, 1);
        const speaking = on && talk.who === i ? 1 : 0;
        tile.emphasis += (speaking - tile.emphasis) * (1 - Math.exp(-dt * 8));
        const e = on ? easeOutBack(tile.t) : tile.t * tile.t;
        const pulse = 1 + tile.emphasis * (0.06 + 0.02 * Math.sin(time * 11));
        tile.obj.visible = tile.t > 0;
        tile.obj.scale.copy(tile.scale).multiplyScalar(Math.max(e, 1e-4) * pulse);
        tile.obj.position.y = tile.y + Math.sin(time * 1.5 + i * 2.1) * 0.012;
        for (const mat of tile.mats) mat.emissive.setScalar(0.08 * tile.emphasis);
      });
    }

    // ---- One frame -------------------------------------------------------------------
    const presence = scenes.map(() => 0);
    const v = new THREE.Vector3();
    const v2 = new THREE.Vector3();
    const m4 = new THREE.Matrix4();
    const q0 = new THREE.Quaternion();
    let sprayDue = 0;
    let netBusy = false;
    let netUntil = 0;
    let dropsDue = 0;

    // `instant` jumps every easing to its end: the reduced-motion path, and first paint.
    function step(dt: number, instant = false) {
      time += dt;
      if (!reduceMotion) advanceDay(dt);
      const clock = clockNow();
      const cfg = scenes[state.index]; // undefined at night
      const actor = current();
      const k = (rate: number) => (instant ? 1 : 1 - Math.exp(-dt * rate));
      const still = reduceMotion ? 0 : 1;

      const wallClock = actors[WORK]?.clock;
      if (wallClock) {
        // seen from the front, clockwise is a negative turn about z
        wallClock.hour.rotation.z = -((clock % 12) / 12) * TAU;
        wallClock.minute.rotation.z = -(clock % 1) * TAU;
      }
      applySky(clock);

      scenes.forEach((_, i) => {
        const to = i === state.index ? 1 : 0;
        presence[i] = instant ? to : clamp(presence[i] + Math.sign(to - presence[i]) * dt * 1.4, 0, 1);
      });
      const atWork = smooth(presence[WORK]);
      const atFarm = smooth(presence[FARM]);
      const atSurf = smooth(presence[SURF]);

      // typing, the call, a word with the agent; watering, pulling: whatever the clock says
      if (actor && cfg?.also && !reduceMotion && !state.waving) {
        const now = cfg.also.findIndex((a, i) => actor.also[i] && clock >= a.from && clock < a.to);
        if (now !== state.also) {
          state.also = now;
          fadeTo(actor, baseAction(actor), timing.crossfade);
        }
      }
      if (actor && talking()) converse(activity()!.tiles ? actor.tiles.length : 1);

      items.forEach((list, i) => {
        const coming = i === state.index;
        for (const item of list) {
          if (instant) item.t = coming ? 1 : 0;
          else if (!coming) item.t = Math.max(0, item.t - dt / timing.propsOut);
          else if (item.wait > 0) item.wait -= dt;
          else item.t = Math.min(1, item.t + dt / timing.propsIn);
          // in: pop past full size and settle. out: hesitate, then drop away.
          const e = coming ? easeOutBack(item.t) : 1 - Math.pow(1 - item.t, 2);
          item.obj.visible = item.t > 0;
          item.obj.scale.copy(item.scale).multiplyScalar(Math.max(e, 1e-4));
          item.obj.position.y = item.y - (1 - Math.min(e, 1)) * item.sink;
        }
      });

      if (instant) {
        spin.yaw = cfg?.homeYaw ?? spin.yaw;
        spin.velocity = 0;
      } else if (!spin.dragging) {
        // keep a little momentum, then settle back to this scene's resting angle
        spin.yaw += spin.velocity;
        spin.velocity *= Math.exp(-dt * 5);
        if (cfg) {
          const home = Math.round((spin.yaw - cfg.homeYaw) / TAU) * TAU + cfg.homeYaw;
          spin.yaw += (home - spin.yaw) * k(2.2);
        }
      }

      // Ride the swell: sample it under the nose, tail and rails of the board.
      const cy = Math.cos(spin.yaw);
      const sy = Math.sin(spin.yaw);
      const at = (along: number, across: number) =>
        swell(along * cy + across * sy, -along * sy + across * cy, time) * atSurf * still;

      actors.forEach((a, i) => {
        if (!a) return;
        // on stage while anything of his is: arriving, here, or still shrinking away
        a.root.visible = items[i].some((item) => item.t > 0);
        if (!a.root.visible) return;
        // The mixer only rewrites a bone when its animated value changes, so last frame's
        // look toward the viewer has to be taken off before it runs and re-applied after.
        for (const l of a.lookChain) l.bone.quaternion.copy(l.pose);
        if (a.pet?.head) a.pet.head.quaternion.copy(a.pet.pose);
        a.mixer.update(instant ? 0 : dt);
        for (const l of a.lookChain) l.pose.copy(l.bone.quaternion);
        if (a.pet?.head) a.pet.pose.copy(a.pet.head.quaternion);
        a.root.rotation.y = spin.yaw;
        if (i === SURF) {
          a.root.position.y = ((at(0.8, 0) + at(-0.8, 0)) / 2) * 0.9;
          a.root.rotation.z = Math.atan2(at(0.8, 0) - at(-0.8, 0), 1.6) * 0.9;
          a.root.rotation.x = Math.atan2(at(0, 0.3) - at(0, -0.3), 0.6) * 0.5 + Math.sin(time * 0.9) * 0.035 * atSurf * still;
        }
        if (a.glow) a.glow.intensity = atWork * (0.35 + still * 0.06 * Math.sin(time * 9) * Math.sin(time * 2.3));
        if (a.tiles.length) call(a, dt);
        if (a.agent && !reduceMotion) buddy(a, dt);
        if (a === actor) face(a);
        if (a === actor && !reduceMotion) notice(a, dt);
        if (a === actor && a.pet && !reduceMotion) petLife(a, clock);
      });

      // -- ambient life --
      if (atWork > 0) {
        moteSeeds.forEach((s, i) => {
          const a = time * s.speed + s.phase;
          v.set(s.x + Math.sin(a) * 0.12, s.y + Math.sin(a * 0.7) * 0.1, s.z + Math.cos(a * 1.3) * 0.12);
          const twinkle = 0.006 + 0.004 * Math.sin(a * 3);
          motes.setMatrixAt(i, m4.compose(v, q0, v2.setScalar(twinkle)));
        });
        motes.instanceMatrix.needsUpdate = true;
      }

      const farmer = actors[FARM];
      if (atFarm > 0) {
        farmer?.leds.forEach((mats, i) => {
          let lit = 0.6; // reduced motion: steady and dim
          if (!reduceMotion) {
            if (i === 0) {
              // heartbeat: a short flash once a second
              lit = time % 1 < 0.12 ? 4 : 0.08;
            } else {
              // network activity: bursts of quick flicker with quiet gaps between
              if (time > netUntil) {
                netBusy = !netBusy;
                netUntil = time + (netBusy ? rand(0.3, 0.9) : rand(0.4, 1.8));
              }
              lit = netBusy && Math.sin(time * 61) * Math.sin(time * 23) > -0.1 ? 4 : 0.08;
            }
          }
          for (const mat of mats ?? []) mat.emissiveIntensity = lit;
        });
        farmer?.sprouts.forEach((s, i) => {
          s.obj.rotation.z = s.rest.z + Math.sin(time * 1.7 + i * 1.3) * 0.11 * still;
          s.obj.rotation.x = s.rest.x + Math.sin(time * 1.3 + i * 2.1) * 0.06 * still;
        });
        butterflies.forEach((b) => {
          const a = time * 0.6 + b.phase;
          v.set(
            -0.55 + Math.sin(a) * 0.75,
            0.75 + Math.sin(a * 2.3) * 0.2 + Math.sin(time * 9 + b.phase) * 0.02,
            0.55 + Math.sin(a * 1.6 + 1) * 0.45,
          );
          if (dt > 0) b.body.rotation.y = Math.atan2(v.x - b.last.x, v.z - b.last.z);
          b.last.copy(v);
          b.body.position.copy(v);
          const flap = 0.15 + Math.abs(Math.sin(time * 13 + b.phase)) * 1.1 * still + (1 - still) * 0.5;
          b.right.rotation.z = flap;
          b.left.rotation.z = -flap;
        });
      }
      if (!reduceMotion) {
        dropsDue -= dt;
        if (farmer?.spout && farmer.can && presence[FARM] === 1 && dropsDue <= 0 && !state.waving) {
          farmer.spout.getWorldPosition(v);
          farmer.can.getWorldPosition(v2);
          // pouring whenever the spout tip dips below the body of the can
          if ((v2.y - v.y) / (v.distanceTo(v2) || 1) > 0.05) {
            dropsDue = 0.05;
            v2.subVectors(v, v2).setY(0).normalize().multiplyScalar(0.35);
            v2.x += rand(-0.08, 0.08);
            v2.z += rand(-0.08, 0.08);
            drops.spawn(v, v2, 1.2);
          }
        }
        drops.update(dt, 5, 0.06);

        // the bed waters itself too: a bead from each emitter every second or two
        if (presence[FARM] === 1) {
          for (const drip of farmer?.drips ?? []) {
            drip.due -= dt;
            if (drip.due > 0) continue;
            drip.due = rand(1.2, 2.5);
            drips.spawn(drip.obj.getWorldPosition(v), v2.set(0, 0, 0), 0.24);
          }
        }
        drips.update(dt, 3, -1);

        sprayDue -= dt;
        const surfer = actors[SURF];
        if (surfer && presence[SURF] === 1 && sprayDue <= 0) {
          sprayDue = rand(0.03, 0.09);
          // off the nose and along the rail facing the swell
          surfer.root.localToWorld(v.set(rand(0.55, 1.0), 0.06, rand(-0.16, 0.16)));
          v2.set(rand(-1.3, -0.5), rand(0.5, 1.3), rand(-0.5, 0.5)).applyQuaternion(surfer.root.quaternion);
          spray.spawn(v, v2, rand(0.35, 0.6));
        }
        spray.update(dt, 4.5, -0.05);

        if (time >= puffDue) {
          puffDue = Infinity;
          for (let i = 0; i < 22; i++) {
            const a = rand(0, TAU);
            v2.set(Math.cos(a) * rand(0.5, 1.4), rand(-0.3, 1.2), Math.sin(a) * rand(0.5, 1.4));
            puff.spawn(puffAt, v2, rand(0.4, 0.7));
          }
        }
        puff.update(dt, 1.5, -1);
      }
      if (atSurf > 0) updateWater(reduceMotion ? 0 : time);

      // on the water his shadow belongs to the waves, not to a flat floor
      shadowCatcher.material.opacity = 0.22 * (1 - atSurf);
      if (cfg) {
        frameNow.width += (cfg.frame.width - frameNow.width) * k(2.5);
        frameNow.height += (cfg.frame.height - frameNow.height) * k(2.5);
        frameNow.pitch += (cfg.frame.pitch - frameNow.pitch) * k(2.5);
      }
      placeCamera();

      paint(time);
    }

    // ---- Run only while someone can see it, and hasn't paused it ---------------------------
    let raf = 0;
    let onScreen = true;
    let lastTick = 0;
    function tick(now: number) {
      raf = 0;
      // capped, so coming back from a hidden tab or a pause doesn't fast-forward the day
      step(Math.min((now - lastTick) / 1000, 0.05));
      lastTick = now;
      schedule();
    }
    function schedule() {
      if (raf || reduceMotion || state.paused || !onScreen || document.hidden) return;
      raf = requestAnimationFrame(tick);
    }
    document.addEventListener("visibilitychange", schedule);
    new IntersectionObserver(([entry]) => {
      onScreen = entry.isIntersecting;
      schedule();
    }).observe(host);

    function resize() {
      const w = host.clientWidth;
      const h = host.clientHeight;
      if (!w || !h) return;
      renderer.setSize(w, h, false);
      sizePaint();
      camera.aspect = w / h;
      // setSize clears the canvas; redraw now rather than flash until the next frame
      step(0, reduceMotion);
    }
    resize();
    step(0, true);
    // first paint has everything in place; rewind so the day opens with him and his desk popping in
    if (!reduceMotion) {
      items[0].forEach((item) => (item.t = 0));
      queueItems(0, 0.2);
      step(0);
    }
    new ResizeObserver(resize).observe(host);

    announce();
    stage.classList.add("is-ready");
    document.documentElement.dataset.character = "ready";
    schedule();
  }

  document.querySelectorAll<HTMLElement>("[data-character-stage]").forEach((stage) => {
    mount(stage).catch((err) => {
      console.warn("Character unavailable:", err);
      document.documentElement.dataset.character = "failed";
    });
  });
</script>
